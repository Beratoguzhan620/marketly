{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "ApiKey": ""
  }
}
