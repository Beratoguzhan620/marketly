@model HomeProductDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var canShop = User.IsInRole("buyer") || User.IsInRole("seller");
    var stockClass = Model.StockAmount == 0 ? "out" : Model.StockAmount < 10 ? "low" : "";
    var stockText = Model.StockAmount == 0 ? "Tükendi" : Model.StockAmount < 10 ? $"Son {Model.StockAmount} ürün" : "Stokta";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Ana sayfa</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Listing", new { category = Model.CategoryId })">@Model.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<partial name="Partials/ViewMessages" />

<div class="product-detail mb-5">
    <div>
        <partial name="Partials/ProductMedia" model="@(new ProductMediaViewModel(Model.ImageUrls.FirstOrDefault(), Model.Name, Model.CategoryId, Model.CategoryName, "gallery-main"))" />
        @if (Model.ImageUrls.Length > 1)
        {
            <div class="gallery-thumbs" role="list" aria-label="Ürün görselleri">
                @for (var i = 0; i < Model.ImageUrls.Length; i++)
                {
                    <button type="button" role="listitem" class="gallery-thumb @(i == 0 ? "active" : null)" data-gallery-src="@Model.ImageUrls[i]" aria-label="Görsel @(i + 1)">
                        <img src="@Model.ImageUrls[i]" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>

    <div class="product-info">
        <a class="small text-decoration-none" href="@Url.Action("Listing", new { category = Model.CategoryId })">@Model.CategoryName</a>
        <h1>@Model.Name</h1>
        <div class="meta-line">
            @if (Model.AverageStarCount is not null)
            {
                <a class="rating text-decoration-none" href="#reviews"><partial name="Partials/ReviewStars" model="Model.AverageStarCount" /><span class="count">@Display.Rating(Model.AverageStarCount.Value) · @Model.Reviews.Length yorum</span></a>
            }
            else
            {
                <a class="text-muted" href="#reviews">Henüz yorum yok</a>
            }
            <span><i class="bi bi-shop me-1"></i>@Model.SellerName</span>
        </div>

        <div class="buy-box">
            <div class="price price-lg">
                <span class="current">@Display.Money(Model.FinalPrice)</span>
                @if (Model.DiscountRate is > 0)
                {
                    <span class="old">@Display.Money(Model.Price)</span>
                    <span class="badge badge-accent">%@Model.DiscountRate indirim</span>
                }
            </div>
            <div class="stock-line @stockClass"><span class="dot"></span>@stockText</div>

            @if (Model.StockAmount > 0 && (canShop || !isAuthenticated))
            {
                <a class="btn btn-primary w-100" asp-controller="Cart" asp-action="AddProduct" asp-route-productId="@Model.Id">
                    <i class="bi bi-bag-plus"></i>Sepete ekle
                </a>
                @if (!isAuthenticated)
                {
                    <p class="form-text text-center mb-0 mt-2">Sepete eklemek için giriş yapmanız istenecek.</p>
                }
            }
            else if (Model.StockAmount == 0)
            {
                <button class="btn btn-outline-secondary w-100" type="button" disabled>Stokta yok</button>
            }
        </div>

        <h2 class="h6">Ürün açıklaması</h2>
        <p class="mb-4" style="white-space: pre-line">@Model.Description</p>

        <dl class="spec-list">
            <dt>Satıcı</dt><dd>@Model.SellerName</dd>
            <dt>Kategori</dt><dd>@Model.CategoryName</dd>
            <dt>Stok</dt><dd class="font-mono">@Model.StockAmount</dd>
        </dl>
    </div>
</div>

<section class="row g-4 mb-5" id="reviews" aria-labelledby="reviews-title">
    <div class="col-lg-7">
        <div class="section-header">
            <div>
                <h2 id="reviews-title">Yorumlar</h2>
                <p>Yalnızca onaylanan yorumlar gösterilir.</p>
            </div>
        </div>

        @if (Model.Reviews.Length == 0)
        {
            <partial name="Partials/EmptyState" model="@(new EmptyStateViewModel("Henüz yorum yok", "Bu ürünü deneyen ilk kişi siz olun.", "bi-chat-square-text"))" />
        }
        else
        {
            <div class="review-summary">
                <span class="score">@Display.Rating(Model.AverageStarCount!.Value)</span>
                <div>
                    <div class="rating rating-lg"><partial name="Partials/ReviewStars" model="Model.AverageStarCount" /></div>
                    <div class="text-muted small">@Model.Reviews.Length onaylı yorum</div>
                </div>
            </div>
            <ul class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    <li class="review-item">
                        <header>
                            <strong class="small">@review.UserName</strong>
                            <span class="text-muted small">@Display.Date(review.CreatedAt)</span>
                        </header>
                        <div class="rating mb-1"><partial name="Partials/ReviewStars" model="@((double?)review.StarCount)" /></div>
                        <p>@review.Text</p>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Yorum yazın</h2>
                @if (canShop)
                {
                    <form method="post" asp-controller="Product" asp-action="Comment" asp-route-productId="@Model.Id">
                        <fieldset class="mb-3">
                            <legend class="form-label">Puanınız</legend>
                            <div class="star-input">
                                @for (var star = 5; star >= 1; star--)
                                {
                                    <input type="radio" id="star-@star" name="StarCount" value="@star" @(star == 5 ? "checked" : null) />
                                    <label for="star-@star" title="@star yıldız"><i class="bi bi-star-fill"></i><span class="visually-hidden">@star yıldız</span></label>
                                }
                            </div>
                        </fieldset>
                        <div class="mb-3">
                            <label class="form-label" for="reviewText">Yorumunuz</label>
                            <textarea class="form-control" id="reviewText" name="Text" rows="4" minlength="5" maxlength="500" required placeholder="Ürünü nasıl buldunuz?"></textarea>
                            <div class="form-text">Yorumlar yönetici onayından sonra yayınlanır.</div>
                        </div>
                        <button class="btn btn-primary" type="submit">Gönder</button>
                    </form>
                }
                else if (!isAuthenticated)
                {
                    <p class="text-muted small mb-3">Yorum yazmak için giriş yapın.</p>
                    <a class="btn btn-outline-secondary" asp-controller="Auth" asp-action="Login">Giriş yap</a>
                }
                else
                {
                    <p class="text-muted small mb-0">Yorumları alıcı ve satıcı hesapları yazabilir.</p>
                }
            </div>
        </div>
    </div>
</section>

@if (Model.RelatedProducts.Count > 0)
{
    <section aria-labelledby="related-title">
        <div class="section-header">
            <div><h2 id="related-title">Aynı kategoriden</h2></div>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Listing", new { category = Model.CategoryId })">Tümünü gör</a>
        </div>
        <div class="product-grid cols-4">
            @foreach (var product in Model.RelatedProducts)
            {
                <partial name="Partials/ProductCard" model="product" />
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        document.querySelectorAll("[data-gallery-src]").forEach(function (thumb) {
            thumb.addEventListener("click", function () {
                var main = document.querySelector(".gallery-main img");
                if (main) { main.src = thumb.dataset.gallerySrc; }
                document.querySelectorAll(".gallery-thumb").forEach(function (t) { t.classList.toggle("active", t === thumb); });
            });
        });
    </script>
}
