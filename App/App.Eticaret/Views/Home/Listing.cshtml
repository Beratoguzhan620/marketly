@model ProductListingPageViewModel
@using App.Application.Models.Requests
@{
    var q = Model.Query;
    var title = Model.SelectedCategory?.Name ?? (q.OnlyDiscounted ? "İndirimdeki ürünler" : "Tüm ürünler");
    if (!string.IsNullOrWhiteSpace(q.Search)) { title = $"“{q.Search}” için sonuçlar"; }
    ViewData["Title"] = title;
    var result = Model.Result;
    string ListUrl(Dictionary<string, string?> values) => Url.Action("Listing", "Home", values)!;
    string? Invariant(decimal? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Ana sayfa</a></li>
                <li class="breadcrumb-item @(Model.SelectedCategory is null ? "active" : null)">
                    @if (Model.SelectedCategory is null) { <span>Ürünler</span> } else { <a asp-action="Listing">Ürünler</a> }
                </li>
                @if (Model.SelectedCategory is not null)
                {
                    <li class="breadcrumb-item active" aria-current="page">@Model.SelectedCategory.Name</li>
                }
            </ol>
        </nav>
        <h1>@title</h1>
    </div>
</div>

<div class="listing-layout">
    <button class="btn btn-outline-secondary filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#filters" aria-expanded="false" aria-controls="filters">
        <i class="bi bi-sliders"></i>Filtreler
    </button>

    <aside class="filter-panel collapse" id="filters" aria-label="Filtreler">
        <div class="filter-group">
            <h2>Kategori</h2>
            <ul class="category-filter">
                <li>
                    <a class="@(q.CategoryId is null ? "active" : null)" href="@ListUrl(Model.RouteValues(clearCategory: true))">
                        <span>Tümü</span>
                    </a>
                </li>
                @foreach (var category in Model.Categories)
                {
                    <li>
                        <a class="@(q.CategoryId == category.Id ? "active" : null)" href="@ListUrl(Model.RouteValues(category: category.Id))">
                            <span>@category.Name</span><span class="count">@category.ProductCount</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <form class="filter-group" method="get" asp-action="Listing">
            <h2>Fiyat (₺)</h2>
            @if (!string.IsNullOrWhiteSpace(q.Search)) { <input type="hidden" name="search" value="@q.Search" /> }
            @if (q.CategoryId is not null) { <input type="hidden" name="category" value="@q.CategoryId" /> }
            @if (q.Sort != ProductSort.Newest) { <input type="hidden" name="sort" value="@q.Sort" /> }
            <div class="d-flex gap-2 align-items-center mb-3">
                <input class="form-control" type="number" name="min" min="0" step="1" value="@Invariant(q.MinPrice)" placeholder="En az" aria-label="En düşük fiyat" />
                <span class="text-muted">–</span>
                <input class="form-control" type="number" name="max" min="0" step="1" value="@Invariant(q.MaxPrice)" placeholder="En çok" aria-label="En yüksek fiyat" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="discounted" value="true" id="onlyDiscounted" @(q.OnlyDiscounted ? "checked" : null) />
                <label class="form-check-label" for="onlyDiscounted">Yalnızca indirimdekiler</label>
            </div>
            <button class="btn btn-outline-secondary w-100" type="submit">Uygula</button>
        </form>
    </aside>

    <section aria-label="Ürün listesi">
        <div class="listing-toolbar">
            <span class="result-count">
                @if (result.TotalCount == 0)
                {
                    <text>Ürün bulunamadı</text>
                }
                else
                {
                    <text><strong class="text-body">@result.TotalCount</strong> üründen @result.FirstItemNumber–@result.LastItemNumber arası</text>
                }
            </span>
            <form method="get" asp-action="Listing" class="d-flex align-items-center gap-2">
                @foreach (var kv in Model.RouteValues().Where(kv => kv.Key is not "sort" and not "page"))
                {
                    <input type="hidden" name="@kv.Key" value="@kv.Value" />
                }
                <label class="text-muted small text-nowrap" for="sort">Sırala</label>
                <select class="form-select form-select-sm" id="sort" name="sort" onchange="this.form.submit()">
                    @foreach (var option in ProductListingPageViewModel.SortOptions)
                    {
                        <option value="@option.Value" selected="@(q.Sort == option.Value)">@option.Text</option>
                    }
                </select>
                <noscript><button class="btn btn-sm btn-outline-secondary" type="submit">Sırala</button></noscript>
            </form>
        </div>

        @if (Model.HasFilters)
        {
            <div class="active-filters" aria-label="Uygulanan filtreler">
                @if (!string.IsNullOrWhiteSpace(q.Search))
                {
                    <a class="filter-chip" href="@ListUrl(Model.RouteValues(clearSearch: true))">Arama: @q.Search <i class="bi bi-x"></i><span class="visually-hidden">kaldır</span></a>
                }
                @if (Model.SelectedCategory is not null)
                {
                    <a class="filter-chip" href="@ListUrl(Model.RouteValues(clearCategory: true))">@Model.SelectedCategory.Name <i class="bi bi-x"></i><span class="visually-hidden">kaldır</span></a>
                }
                @if (q.MinPrice is not null || q.MaxPrice is not null)
                {
                    var priceText = q.MinPrice is not null && q.MaxPrice is not null
                        ? $"{Display.Money(q.MinPrice.Value)} – {Display.Money(q.MaxPrice.Value)}"
                        : q.MinPrice is not null ? $"{Display.Money(q.MinPrice.Value)} ve üzeri" : $"{Display.Money(q.MaxPrice!.Value)} ve altı";
                    <a class="filter-chip" href="@ListUrl(Model.RouteValues(clearPrice: true))">@priceText <i class="bi bi-x"></i><span class="visually-hidden">kaldır</span></a>
                }
                @if (q.OnlyDiscounted)
                {
                    <a class="filter-chip" href="@ListUrl(Model.RouteValues(clearDiscount: true))">İndirimdekiler <i class="bi bi-x"></i><span class="visually-hidden">kaldır</span></a>
                }
                <a class="filter-chip" asp-action="Listing">Tümünü temizle</a>
            </div>
        }

        @if (result.Items.Count == 0)
        {
            <partial name="Partials/EmptyState" model="@(new EmptyStateViewModel(
                "Aramanızla eşleşen ürün yok",
                "Filtreleri gevşetmeyi ya da farklı bir kelimeyle aramayı deneyin.",
                "bi-search",
                "Filtreleri temizle",
                Url.Action("Listing")))" />
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in result.Items)
                {
                    <partial name="Partials/ProductCard" model="product" />
                }
            </div>

            <div class="d-flex justify-content-center mt-4">
                <partial name="Partials/Pagination" model="@(new PaginationViewModel
                {
                    Page = result.Page,
                    TotalPages = result.TotalPages,
                    PageUrl = p => ListUrl(Model.RouteValues(page: p)),
                })" />
            </div>
        }
    </section>
</div>
