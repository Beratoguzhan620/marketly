@model NewContactFormMessageViewModel
@{
    ViewData["Title"] = "İletişim";
}

<div class="page-header">
    <div>
        <h1>İletişim</h1>
        <p>Sorularınızı ve önerilerinizi bize iletin; en geç iki iş günü içinde dönüş yapıyoruz.</p>
    </div>
</div>

<div class="row g-5">
    <div class="col-lg-7">
        <partial name="Partials/ViewMessages" />
        <form class="form-narrow" asp-controller="Home" asp-action="Contact" method="post" novalidate>
            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input class="form-control" asp-for="Name" autocomplete="name" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="Message"></label>
                <textarea class="form-control" asp-for="Message" rows="6"></textarea>
                <span asp-validation-for="Message"></span>
            </div>
            <button class="btn btn-primary" type="submit">Gönder</button>
        </form>
    </div>
    <div class="col-lg-5">
        <ul class="contact-list">
            <li><i class="bi bi-envelope"></i><div><strong class="d-block">E-posta</strong><a href="mailto:destek@marketly.example">destek@marketly.example</a></div></li>
            <li><i class="bi bi-clock"></i><div><strong class="d-block">Çalışma saatleri</strong><span class="text-muted">Hafta içi 09.00–18.00</span></div></li>
            <li><i class="bi bi-shop"></i><div><strong class="d-block">Satıcı olmak için</strong><span class="text-muted">Hesabınızdaki “Satıcı başvurusu” bölümünü kullanın.</span></div></li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
