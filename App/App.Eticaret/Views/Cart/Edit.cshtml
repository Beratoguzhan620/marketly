@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Sepetim";
}

<partial name="Partials/CheckoutSteps" model="1" />

<div class="page-header">
    <div>
        <h1>Sepetim</h1>
        @if (Model.Count > 0)
        {
            <p>@Model.Count farklı ürün, @Model.Sum(i => i.Quantity) adet.</p>
        }
    </div>
</div>

<partial name="Partials/ViewMessages" />

@if (Model.Count == 0)
{
    <partial name="Partials/EmptyState" model="@(new EmptyStateViewModel("Sepetiniz boş", "Beğendiğiniz ürünleri sepete ekleyin; siparişi buradan tamamlayabilirsiniz.", "bi-bag", "Alışverişe başla", Url.Action("Listing", "Home")))" />
}
else
{
    <div class="cart-layout">
        <div class="card">
            @foreach (var item in Model)
            {
                <div class="cart-line">
                    <partial name="Partials/ProductMedia" model="@(new ProductMediaViewModel(item.ProductImage, item.ProductName, item.CategoryId, item.CategoryName))" />
                    <div>
                        <a class="cart-line-name" asp-controller="Home" asp-action="ProductDetail" asp-route-productId="@item.ProductId">@item.ProductName</a>
                        <div class="price small mt-1">
                            <span class="current">@Display.Money(item.Price)</span>
                            @if (item.DiscountRate is > 0)
                            {
                                <span class="old">@Display.Money(item.ListPrice)</span>
                            }
                            <span class="text-muted">/ adet</span>
                        </div>
                    </div>
                    <div class="cart-line-controls">
                        <form method="post" asp-controller="Cart" asp-action="UpdateCart" class="qty-form">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <div class="qty-stepper">
                                <button type="button" data-qty-step="-1" aria-label="Azalt" @(item.Quantity <= 1 ? "disabled" : null)><i class="bi bi-dash"></i></button>
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockAmount" aria-label="@item.ProductName adedi" />
                                <button type="button" data-qty-step="1" aria-label="Arttır" @(item.Quantity >= item.StockAmount ? "disabled" : null)><i class="bi bi-plus"></i></button>
                            </div>
                            <noscript><button class="btn btn-sm btn-outline-secondary ms-2" type="submit">Güncelle</button></noscript>
                        </form>
                        <form method="post" asp-controller="Cart" asp-action="Remove" asp-route-cartItemId="@item.Id">
                            <button type="submit" class="btn btn-ghost btn-sm" aria-label="@item.ProductName ürününü sepetten çıkar"><i class="bi bi-trash"></i><span class="d-none d-sm-inline">Çıkar</span></button>
                        </form>
                    </div>
                    <div class="line-total">@Display.Money(item.TotalPrice)</div>
                </div>
            }
        </div>

        <aside class="summary-card" aria-label="Sipariş özeti">
            <h2>Sipariş özeti</h2>
            <partial name="Partials/OrderSummary" model="Model" />
            <a class="btn btn-primary w-100 mt-3" asp-controller="Cart" asp-action="Checkout">Teslimat bilgilerine geç<i class="bi bi-arrow-right"></i></a>
            <a class="btn btn-link w-100 mt-2" asp-controller="Home" asp-action="Listing">Alışverişe devam et</a>
        </aside>
    </div>
}

@section Scripts {
    <script>
        // The stepper changes the number and submits the form; works as a plain form without JS.
        document.querySelectorAll(".qty-form").forEach(function (form) {
            var input = form.querySelector("input[name=quantity]");
            form.querySelectorAll("[data-qty-step]").forEach(function (button) {
                button.addEventListener("click", function () {
                    var next = parseInt(input.value, 10) + parseInt(button.dataset.qtyStep, 10);
                    var max = parseInt(input.max, 10) || 255;
                    if (next < 1 || next > max) return;
                    input.value = next;
                    form.submit();
                });
            });
            input.addEventListener("change", function () { form.submit(); });
        });
    </script>
}
