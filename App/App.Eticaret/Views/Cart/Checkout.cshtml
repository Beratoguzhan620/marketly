@model List<CartItemViewModel>
@{
    ViewData["Title"] = "Teslimat bilgileri";
    var address = Context.Request.HasFormContentType ? Context.Request.Form["Address"].ToString() : string.Empty;
    var addressError = ViewData.ModelState["Address"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<partial name="Partials/CheckoutSteps" model="2" />

<div class="page-header">
    <div>
        <h1>Teslimat bilgileri</h1>
        <p>Siparişiniz bu adrese gönderilecek. Ödeme alınmaz; bu bir demo mağazadır.</p>
    </div>
</div>

<partial name="Partials/ViewMessages" />

<div class="cart-layout">
    <form class="card" method="post" asp-controller="Order" asp-action="Create" id="checkoutForm" novalidate>
        <div class="card-body p-4">
            <div class="mb-3">
                <label class="form-label" for="Address">Teslimat adresi</label>
                <textarea class="form-control @(addressError is null ? null : "input-validation-error")" id="Address" name="Address" rows="4" minlength="10" maxlength="250" required
                          placeholder="Mahalle, sokak, bina ve daire no, ilçe / il">@address</textarea>
                @if (addressError is not null)
                {
                    <span class="field-validation-error">@addressError</span>
                }
                <div class="form-text">En az 10 karakter. Kapı numarası ve ilçeyi eklemeyi unutmayın.</div>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-4">
                <a class="btn btn-link px-0" asp-controller="Cart" asp-action="Edit"><i class="bi bi-arrow-left"></i>Sepete dön</a>
                <button class="btn btn-primary" type="submit">Siparişi onayla</button>
            </div>
        </div>
    </form>

    <aside class="summary-card" aria-label="Sipariş özeti">
        <h2>Sipariş özeti</h2>
        <ul class="summary-items">
            @foreach (var item in Model)
            {
                <li><span>@item.ProductName <span class="qty">× @item.Quantity</span></span><span class="font-mono">@Display.Money(item.TotalPrice)</span></li>
            }
        </ul>
        <partial name="Partials/OrderSummary" model="Model" />
    </aside>
</div>
