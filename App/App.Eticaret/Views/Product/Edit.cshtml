@model SaveProductViewModel
@{
    ViewData["Title"] = $"{Model.Name} · Düzenle";
    ViewData["IsEdit"] = true;
    var productId = Context.GetRouteValue("productId");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="MyProducts">Ürünlerim</a></li>
        <li class="breadcrumb-item active" aria-current="page">Düzenle</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p>Değişiklikler kaydedildiği anda mağazaya yansır.</p>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="ProductDetail" asp-route-productId="@productId"><i class="bi bi-box-arrow-up-right"></i>Mağazada gör</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <partial name="Partials/ViewMessages" />
                <form asp-controller="Product" asp-action="Edit" asp-route-productId="@productId" method="post" enctype="multipart/form-data" novalidate>
                    <partial name="_ProductFields" model="Model" />
                    <button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Mevcut görseller</h2>
                @if (Model.CurrentImages.Count == 0)
                {
                    <p class="text-muted small mb-0">Bu ürünün görseli yok; mağazada kategori görseli gösterilir.</p>
                }
                else
                {
                    <div class="image-picker">
                        @foreach (var image in Model.CurrentImages)
                        {
                            <div class="thumb">
                                <img src="@image.Url" alt="" loading="lazy" />
                                <form asp-controller="Product" asp-action="DeleteImage" asp-route-productId="@productId" asp-route-imageId="@image.Id" method="post">
                                    <button type="submit" class="btn btn-light btn-sm" aria-label="Görseli sil" title="Görseli sil"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
