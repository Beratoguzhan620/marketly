@using Microsoft.EntityFrameworkCore
@using App.Data.Entities
@model SaveProductViewModel
@inject App.Data.Infrastructure.DataRepository<DiscountEntity> discountRepository
@inject App.Data.Infrastructure.DataRepository<CategoryEntity> categoryRepository
@{
    ViewData["Title"] = "Edit Product";
    var discounts = await discountRepository.GetAll()
                .Where(d => d.Enabled)
                .Select(d => new DiscountSelectItemViewModel { Id = d.Id, Rate = d.DiscountRate })
                .ToListAsync();
    var categories = await categoryRepository.GetAll()
                .Select(c => new CategorySelectItemViewModel { Id = c.Id, Name = c.Name })
                .ToListAsync();

    var imageUploadModel = new ImageUploadViewModel
    {
        Name = nameof(Model.Images),
        Label = "Add More Images",
        IsRequired = false,
        IsMultipleFiles = true,
        Accept = "image/png, image/jpeg, image/webp"
    };
}

<div class="container">
    <div class="row">
        <div class="col-md-8 col-lg-6 mx-auto">
            <h2 class="mb-3">Edit Product</h2>
            <partial name="Partials/ViewMessages" />

            @if (Model.CurrentImages.Count > 0)
            {
                <div class="form-group">
                    <label>Current Images</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var image in Model.CurrentImages)
                        {
                            <div class="position-relative me-2 mb-2" style="width:100px;">
                                <img src="@image.Url" alt="" style="width:100px;height:100px;object-fit:cover;" onerror="this.src='/theme/img/product/product-1.jpg'" />
                                <form asp-action="DeleteImage" asp-route-productId="@(Context.GetRouteValue("productId"))" asp-route-imageId="@(image.Id)" method="post" onsubmit="return confirm('Bu görseli silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-danger w-100 mt-1">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }

            <form asp-action="Edit" asp-route-productId="@(Context.GetRouteValue("productId"))" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label asp-for="CategoryId">Category</label>
                    <select asp-for="CategoryId" asp-items="@(new SelectList(categories, nameof(CategorySelectItemViewModel.Id), nameof(CategorySelectItemViewModel.Name)))" class="form-control">
                        <option value="">Select Category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DiscountId">Discount</label>
                    <select asp-for="DiscountId" asp-items="@(new SelectList(discounts, nameof(DiscountSelectItemViewModel.Id), nameof(DiscountSelectItemViewModel.Rate)))" class="form-control">
                        <option value="">Select Discount</option>
                    </select>
                    <span asp-validation-for="DiscountId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StockAmount">Stock Amount</label>
                    <input asp-for="StockAmount" class="form-control" />
                    <span asp-validation-for="StockAmount" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <partial name="Partials/ImageUpload" model="imageUploadModel" />
                    <span asp-validation-for="Images" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial.cshtml" />
}






