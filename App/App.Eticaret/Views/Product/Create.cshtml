@model SaveProductViewModel
@{
    ViewData["Title"] = "Ürün ekle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="MyProducts">Ürünlerim</a></li>
        <li class="breadcrumb-item active" aria-current="page">Ürün ekle</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>Ürün ekle</h1>
        <p>Ürün kaydedildikten sonra mağazada hemen listelenir.</p>
    </div>
</div>

<div class="card form-narrow">
    <div class="card-body p-4">
        <partial name="Partials/ViewMessages" />
        <form asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_ProductFields" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Ürünü kaydet</button>
                <a class="btn btn-outline-secondary" asp-controller="Profile" asp-action="MyProducts">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
