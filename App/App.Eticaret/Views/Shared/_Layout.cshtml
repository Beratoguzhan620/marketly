<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="Partials/PageHead" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" href="#main">İçeriğe geç</a>

    <partial name="Partials/Header" />

    <main class="shop-main" id="main">
        <div class="container-shop">
            @RenderBody()
        </div>
    </main>

    <partial name="Partials/Footer" />

    <partial name="Partials/PageScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
