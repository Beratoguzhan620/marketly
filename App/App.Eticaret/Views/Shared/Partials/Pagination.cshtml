@model PaginationViewModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="Sayfalar">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                <a class="page-link" href="@(Model.Page <= 1 ? null : Model.PageUrl(Model.Page - 1))" aria-label="Önceki sayfa"><i class="bi bi-chevron-left"></i></a>
            </li>
            @foreach (var p in Model.Window())
            {
                if (p is null)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.Page ? "active" : null)">
                        <a class="page-link" href="@Model.PageUrl(p.Value)" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                <a class="page-link" href="@(Model.Page >= Model.TotalPages ? null : Model.PageUrl(Model.Page + 1))" aria-label="Sonraki sayfa"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
