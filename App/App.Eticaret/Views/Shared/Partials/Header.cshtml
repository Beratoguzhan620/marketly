@using System.Security.Claims
@using App.Application.Services.Interfaces
@inject ICartService cartService
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    bool Is(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));

    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var firstName = User.FindFirstValue(ClaimTypes.Name);
    var isSeller = User.IsInRole("seller");
    var canShop = User.IsInRole("buyer") || isSeller;

    var cartCount = 0;
    if (canShop && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
    {
        var cart = await cartService.GetCartAsync(userId);
        cartCount = cart.Items.Sum(i => i.Quantity);
    }

    var search = Context.Request.Query["search"].ToString();
}

<header class="shop-header">
    <div class="container-shop">
        <div class="shop-header-row">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">M</span>Marketly</a>

            <form class="shop-search ms-md-4" role="search" method="get" asp-controller="Home" asp-action="Listing">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input class="form-control" type="search" name="search" value="@search" placeholder="Ürün veya kategori ara" aria-label="Ürün ara" />
            </form>

            <div class="header-actions">
                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <button class="header-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Hesabım">
                            <i class="bi bi-person"></i><span class="header-label">@firstName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Details"><i class="bi bi-person me-2"></i>Hesabım</a></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="MyOrders"><i class="bi bi-receipt me-2"></i>Siparişlerim</a></li>
                            @if (isSeller)
                            {
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="MyProducts"><i class="bi bi-box-seam me-2"></i>Ürünlerim</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Ürün ekle</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="header-icon-btn" asp-controller="Auth" asp-action="Login" aria-label="Giriş yap">
                        <i class="bi bi-person"></i><span class="header-label">Giriş yap</span>
                    </a>
                }

                <a class="header-icon-btn" asp-controller="Cart" asp-action="Edit" aria-label="Sepet, @cartCount ürün">
                    <i class="bi bi-bag"></i>
                    @if (cartCount > 0)
                    {
                        <span class="cart-count" data-cart-count>@cartCount</span>
                    }
                    <span class="header-label">Sepet</span>
                </a>
            </div>
        </div>

        <form class="mobile-search shop-search" role="search" method="get" asp-controller="Home" asp-action="Listing">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="form-control" type="search" name="search" value="@search" placeholder="Ürün veya kategori ara" aria-label="Ürün ara" />
        </form>

        <nav class="shop-nav" aria-label="Ana menü">
            <a class="@(Is("Home", "Index") ? "active" : null)" asp-controller="Home" asp-action="Index">Ana sayfa</a>
            <a class="@(Is("Home", "Listing") || Is("Home", "ProductDetail") ? "active" : null)" asp-controller="Home" asp-action="Listing">Tüm ürünler</a>
            <a href="@Url.Action("Listing", "Home", new { discounted = true })">İndirimdekiler</a>
            <a class="@(Is("Home", "AboutUs") ? "active" : null)" asp-controller="Home" asp-action="AboutUs">Hakkımızda</a>
            <a class="@(Is("Home", "Contact") ? "active" : null)" asp-controller="Home" asp-action="Contact">İletişim</a>
            @if (isAuthenticated && !isSeller)
            {
                <a class="ms-auto" asp-controller="Profile" asp-action="Details" asp-fragment="seller">Satıcı olun</a>
            }
        </nav>
    </div>
</header>
