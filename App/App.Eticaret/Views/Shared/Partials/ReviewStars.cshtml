@model double?
@{
    var rating = Math.Clamp(Model ?? 0, 0, 5);
    var rounded = Math.Round(rating * 2, MidpointRounding.AwayFromZero) / 2;
    var full = (int)rounded;
    var half = rounded - full >= .5;
}
<span class="visually-hidden">5 üzerinden @Display.Rating(rating) puan</span>
@for (var i = 1; i <= 5; i++)
{
    var icon = i <= full ? "bi-star-fill" : (half && i == full + 1 ? "bi-star-half" : "bi-star");
    <i class="bi @icon" aria-hidden="true"></i>
}
