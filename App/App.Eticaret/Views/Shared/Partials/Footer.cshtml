<footer class="shop-footer">
    <div class="container-shop">
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <a class="brand mb-3" asp-controller="Home" asp-action="Index"><span class="brand-mark">M</span>Marketly</a>
                <p class="text-muted mb-0" style="max-width: 320px">Yerel üreticileri ve onların ürünlerini arayanları buluşturan çok satıcılı pazar yeri.</p>
            </div>
            <div class="col-6 col-lg-2">
                <h2>Alışveriş</h2>
                <ul>
                    <li><a asp-controller="Home" asp-action="Listing">Tüm ürünler</a></li>
                    <li><a href="@Url.Action("Listing", "Home", new { discounted = true })">İndirimdekiler</a></li>
                    <li><a asp-controller="Cart" asp-action="Edit">Sepetim</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h2>Hesap</h2>
                <ul>
                    <li><a asp-controller="Profile" asp-action="Details">Hesabım</a></li>
                    <li><a asp-controller="Profile" asp-action="MyOrders">Siparişlerim</a></li>
                    <li><a asp-controller="Auth" asp-action="Register">Kayıt ol</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h2>Marketly</h2>
                <ul>
                    <li><a asp-controller="Home" asp-action="AboutUs">Hakkımızda</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">İletişim</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h2>Destek</h2>
                <ul>
                    <li><a href="mailto:destek@marketly.example">destek@marketly.example</a></li>
                    <li class="text-muted">Hafta içi 09.00–18.00</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.UtcNow.Year Marketly. Portföy projesidir; gerçek satış yapılmaz.</span>
            <span>Fiyatlara KDV dahildir.</span>
        </div>
    </div>
</footer>
