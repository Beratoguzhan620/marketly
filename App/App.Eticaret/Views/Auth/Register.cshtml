@model RegisterUserViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Kayıt ol";
}

<h1>Hesap oluşturun</h1>
<p class="lead-text">Alışverişe hemen başlayın; satıcı olmak için daha sonra hesabınızdan başvurabilirsiniz.</p>

<partial name="Partials/ViewMessages" />

<form method="post" asp-controller="Auth" asp-action="Register" novalidate>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label class="form-label" asp-for="FirstName"></label>
            <input class="form-control" asp-for="FirstName" autocomplete="given-name" autofocus />
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="col-sm-6">
            <label class="form-label" asp-for="LastName"></label>
            <input class="form-control" asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName"></span>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Email"></label>
        <input class="form-control" asp-for="Email" type="email" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Password"></label>
        <input class="form-control" asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div class="mb-4">
        <label class="form-label" asp-for="PasswordConfirm"></label>
        <input class="form-control" asp-for="PasswordConfirm" autocomplete="new-password" />
        <span asp-validation-for="PasswordConfirm"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Kayıt ol</button>
</form>

<p class="auth-switch">Zaten hesabınız var mı? <a asp-controller="Auth" asp-action="Login">Giriş yapın</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
