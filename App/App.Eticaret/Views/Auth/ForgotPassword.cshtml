@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifremi unuttum";
}

<h1>Şifrenizi mi unuttunuz?</h1>
<p class="lead-text">Hesabınızın e-posta adresini girin; şifre yenileme bağlantısı gönderelim.</p>

<partial name="Partials/ViewMessages" />

<form method="post" asp-controller="Auth" asp-action="ForgotPassword" novalidate>
    <div class="mb-4">
        <label class="form-label" asp-for="Email"></label>
        <input class="form-control" asp-for="Email" type="email" autocomplete="email" autofocus />
        <span asp-validation-for="Email"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Bağlantı gönder</button>
</form>

<p class="auth-switch"><a asp-controller="Auth" asp-action="Login"><i class="bi bi-arrow-left"></i> Giriş sayfasına dön</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
