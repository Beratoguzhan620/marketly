@model RenewPasswordViewModel
@{
    ViewData["Title"] = "Renew Password";
}

<div class="container-fluid">
    <div class="row">
        <h2 class="col-12 text-center">Renew Password</h2>
        <div class="col-12 col-md-6 offset-md-3">
            <partial name="Partials/ViewMessages" />
            <form asp-controller="Auth" asp-action="RenewPassword" method="post">
                <input type="hidden" asp-for="VerificationCode" />
                <div class="form-group">
                    <label asp-for="Password">New Password</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PasswordConfirm">Confirm New Password</label>
                    <input asp-for="PasswordConfirm" class="form-control" />
                    <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between">
                    <button type="submit" class="site-btn mr-auto">Save</button>
                    <a asp-controller="Auth" asp-action="Login" class="site-btn">Login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
