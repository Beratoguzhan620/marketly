@model RenewPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Yeni şifre";
}

<h1>Yeni şifre belirleyin</h1>
<p class="lead-text">Bağlantı 1 saat geçerlidir. Şifreniz en az 8 karakter olmalı.</p>

<partial name="Partials/ViewMessages" />

<form method="post" asp-controller="Auth" asp-action="RenewPassword" novalidate>
    <input type="hidden" asp-for="VerificationCode" />
    <div class="mb-3">
        <label class="form-label" asp-for="Password"></label>
        <input class="form-control" asp-for="Password" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password"></span>
    </div>
    <div class="mb-4">
        <label class="form-label" asp-for="PasswordConfirm"></label>
        <input class="form-control" asp-for="PasswordConfirm" autocomplete="new-password" />
        <span asp-validation-for="PasswordConfirm"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Şifreyi kaydet</button>
</form>

<p class="auth-switch"><a asp-controller="Auth" asp-action="Login">Giriş sayfasına dön</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
