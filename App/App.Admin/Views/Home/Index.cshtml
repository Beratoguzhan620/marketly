@model AdminDashboardDto
@{
    ViewData["Title"] = "Özet";
    var months = Model.MonthlySales;
    var maxRevenue = Math.Max(1m, months.Max(m => m.Revenue));
    const int chartWidth = 720, chartHeight = 220, top = 24, bottom = 28;
    var barSlot = chartWidth / (double)months.Count;
    var barWidth = barSlot * 0.56;
    var plotHeight = chartHeight - top - bottom;
    var yearRevenue = months.Sum(m => m.Revenue);
    var yearOrders = months.Sum(m => m.OrderCount);
}

<partial name="Partials/_ViewMessages" />

<div class="page-header">
    <div>
        <h1>Özet</h1>
        <p>Mağazanın genel durumu ve bekleyen işler.</p>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="label"><i class="bi bi-receipt"></i>Sipariş</span>
        <span class="value">@Model.OrderCount</span>
        <span class="hint">tüm zamanlar</span>
    </div>
    <div class="stat-card">
        <span class="label"><i class="bi bi-cash-stack"></i>Ciro</span>
        <span class="value">@Display.Money(Model.Revenue)</span>
        <span class="hint">tüm zamanlar, KDV dahil</span>
    </div>
    <a class="stat-card" asp-controller="User" asp-action="List">
        <span class="label"><i class="bi bi-people"></i>Kullanıcı</span>
        <span class="value">@Model.UserCount</span>
        <span class="hint">son 30 günde +@Model.NewUsersLast30Days</span>
    </a>
    <a class="stat-card" asp-controller="Product" asp-action="List" asp-route-status="Active">
        <span class="label"><i class="bi bi-box-seam"></i>Satıştaki ürün</span>
        <span class="value">@Model.ActiveProductCount</span>
        <span class="hint">etkin ürünler</span>
    </a>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <section class="card h-100" aria-labelledby="salesTitle">
            <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                <h2 class="h6 mb-0" id="salesTitle">Aylık ciro · son 12 ay</h2>
                <span class="text-muted small">@yearOrders sipariş · <span class="font-mono">@Display.Money(yearRevenue)</span></span>
            </div>
            <div class="card-body">
                <svg class="chart" viewBox="0 0 @chartWidth @chartHeight" role="img" aria-labelledby="salesTitle salesDesc">
                    <desc id="salesDesc">@string.Join(", ", months.Select(m => $"{Display.MonthShort(m.Year, m.Month)} {m.Year}: {Display.Money(m.Revenue)}"))</desc>
                    @for (var g = 0; g <= 2; g++)
                    {
                        var y = top + plotHeight * g / 2.0;
                        <line class="gridline" x1="0" x2="@chartWidth" y1="@y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="@y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" />
                    }
                    @for (var i = 0; i < months.Count; i++)
                    {
                        var m = months[i];
                        var height = m.Revenue <= 0 ? 3 : Math.Max(3, (double)(m.Revenue / maxRevenue) * plotHeight);
                        var x = i * barSlot + (barSlot - barWidth) / 2;
                        var y = top + plotHeight - height;
                        var inv = System.Globalization.CultureInfo.InvariantCulture;
                        <rect class="bar @(m.Revenue <= 0 ? "empty" : null)" x="@x.ToString("0.#", inv)" y="@y.ToString("0.#", inv)" width="@barWidth.ToString("0.#", inv)" height="@height.ToString("0.#", inv)" rx="3">
                            <title>@Display.MonthShort(m.Year, m.Month) @m.Year: @Display.Money(m.Revenue), @m.OrderCount sipariş</title>
                        </rect>
                        @if (m.Revenue > 0)
                        {
                            <text class="value-label" x="@((x + barWidth / 2).ToString("0.#", inv))" y="@((y - 6).ToString("0.#", inv))" text-anchor="middle">@m.OrderCount</text>
                        }
                        <text class="axis" x="@((x + barWidth / 2).ToString("0.#", inv))" y="@(chartHeight - 8)" text-anchor="middle">@Display.MonthShort(m.Year, m.Month)</text>
                    }
                </svg>
                <p class="text-muted small mb-0 mt-2">Çubuk yüksekliği ciroyu, üstündeki sayı sipariş adedini gösterir.</p>
            </div>
        </section>
    </div>

    <div class="col-xl-4">
        <section class="card h-100" aria-labelledby="todoTitle">
            <div class="card-header"><h2 class="h6 mb-0" id="todoTitle">Bekleyen işler</h2></div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-controller="Comment" asp-action="List">
                    <span><i class="bi bi-chat-square-text me-2 text-muted"></i>Onay bekleyen yorum</span>
                    <span class="badge @(Model.PendingCommentCount > 0 ? "badge-accent" : "badge-neutral")">@Model.PendingCommentCount</span>
                </a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-controller="User" asp-action="List" asp-route-onlySellerRequests="true">
                    <span><i class="bi bi-shop me-2 text-muted"></i>Satıcı başvurusu</span>
                    <span class="badge @(Model.PendingSellerRequestCount > 0 ? "badge-accent" : "badge-neutral")">@Model.PendingSellerRequestCount</span>
                </a>
            </div>
        </section>
    </div>
</div>

<section class="card mt-4" aria-labelledby="ordersTitle">
    <div class="card-header"><h2 class="h6 mb-0" id="ordersTitle">Son siparişler</h2></div>
    @if (Model.RecentOrders.Count == 0)
    {
        <partial name="Partials/_EmptyState" model="@(("Henüz sipariş yok", "Mağazadan verilen siparişler burada görünecek.", "bi-receipt"))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr><th>Sipariş</th><th>Müşteri</th><th>Tarih</th><th class="num">Adet</th><th class="num">Tutar</th></tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td class="font-mono">@order.OrderCode</td>
                            <td>@order.CustomerName</td>
                            <td class="text-muted">@Display.DateTime(order.CreatedAt)</td>
                            <td class="num">@order.ItemCount</td>
                            <td class="num">@Display.Money(order.Total)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
