@model List<CategoryListViewModel>
@{
    ViewData["Title"] = "Kategoriler";
}

<partial name="Partials/_ViewMessages" />

<div class="page-header">
    <div>
        <h1>Kategoriler</h1>
        <p>Mağazadaki ürün kategorileri. Ürünü olan kategori silinemez.</p>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i>Kategori ekle</a>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <partial name="Partials/_EmptyState" model="@(("Kategori yok", "İlk kategoriyi ekleyerek başlayın.", "bi-tags"))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Kategori</th><th>Renk</th><th>İkon</th><th class="num">Ürün</th><th><span class="visually-hidden">İşlemler</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.OrderBy(c => c.Name))
                    {
                        <tr>
                            <td class="fw-medium">@c.Name</td>
                            <td><span class="color-swatch" style="background: @c.Color"></span>@c.Color</td>
                            <td>@if (!string.IsNullOrEmpty(c.IconCssClass)) { <i class="bi @c.IconCssClass me-1"></i><span class="font-mono small">@c.IconCssClass</span> } else { <span class="text-muted">—</span> }</td>
                            <td class="num">@c.ProductCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-categoryId="@c.Id">Düzenle</a>
                                <form class="d-inline" method="post" asp-action="Delete" asp-route-categoryId="@c.Id"
                                      data-confirm="“@c.Name” kategorisi silinecek." data-confirm-title="Kategoriyi sil" data-confirm-ok="Sil">
                                    <button class="btn btn-ghost btn-sm" type="submit" disabled="@(c.ProductCount > 0)" title="@(c.ProductCount > 0 ? "Ürünü olan kategori silinemez" : null)">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
