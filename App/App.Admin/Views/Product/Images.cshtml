@model AdminProductImagesViewModel
@{
    ViewData["Title"] = $"{Model.ProductName} · Görseller";
}

<partial name="Partials/_ViewMessages" />

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="List">Ürünler</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
            </ol>
        </nav>
        <h1>Görseller</h1>
        <p>@Model.ProductName için mağazada gösterilen görseller. İlk görsel kapak olarak kullanılır.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h2 class="h6 mb-0">Mevcut görseller</h2></div>
            <div class="card-body">
                @if (Model.CurrentImages.Count == 0)
                {
                    <p class="text-muted mb-0">Bu ürünün görseli yok; mağazada kategori yer tutucusu gösterilir.</p>
                }
                else
                {
                    <div class="image-grid">
                        @foreach (var image in Model.CurrentImages)
                        {
                            <figure>
                                <img src="@image.Url" alt="" loading="lazy" />
                                <figcaption>
                                    <form asp-action="DeleteImage" asp-route-productId="@Model.ProductId" asp-route-imageId="@image.Id" method="post"
                                          data-confirm="Görsel kalıcı olarak silinecek." data-confirm-title="Görseli sil" data-confirm-ok="Sil">
                                        <button type="submit" class="btn btn-ghost btn-sm w-100"><i class="bi bi-trash"></i>Sil</button>
                                    </form>
                                </figcaption>
                            </figure>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <form class="card" asp-action="Images" asp-route-productId="@Model.ProductId" method="post" enctype="multipart/form-data">
            <div class="card-header"><h2 class="h6 mb-0">Görsel ekle</h2></div>
            <div class="card-body">
                <input type="file" name="@nameof(Model.NewImages)" id="@nameof(Model.NewImages)" class="form-control" multiple accept="image/png, image/jpeg, image/webp" aria-label="Görsel dosyaları" />
                <div class="form-text">JPG, PNG veya WEBP; birden fazla seçebilirsiniz.</div>
                <span asp-validation-for="NewImages"></span>
                <button type="submit" class="btn btn-primary w-100 mt-3">Yükle</button>
            </div>
        </form>
    </div>
</div>
