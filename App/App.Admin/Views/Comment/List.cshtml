@model List<ProductCommentViewModel>
@{
    ViewBag.Title = "Product Comments";
}

<h2>Ürün Yorumları</h2>

<table class="table">
    <thead>
        <tr>
            <th>Ürün</th>
            <th>Yorum</th>
            <th>Puan</th>
            <th>Sahibi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5">Onay bekleyen yorum bulunmuyor.</td>
            </tr>
        }
        @foreach (var comment in Model)
        {
            <tr id="comment-row-@comment.Id">
                <td>@comment.ProductName</td>
                <td><i>@comment.Text</i></td>
                <td>@comment.StarCount</td>
                <td>@comment.UserName</td>
                <td>
                    <button class="btn btn-primary" onclick="approveComment(@comment.Id)">Approve</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script>
        function approveComment(commentId) {
            // Make a fetch request to the server to approve the comment

            fetch(`/comment/${commentId}/approve`)
                .then(response => response.json())
                .then(data => {
                    // Refresh the page to update the approved status
                    location.reload();
                })
                .catch(error => {
                    alert('Yorum onaylanamadı...');
                });
        }
    </script>
}
